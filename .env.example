# Buvio mobile — local development.
#
# Variable names must match what the code reads:
#   src/utils/env-variables      -> EXPO_PUBLIC_ENV
#   src/utils/environment        -> EXPO_PUBLIC_URL_<ENV in caps>
# The Apollo client then appends "/graphql" to that base URL.

EXPO_PUBLIC_ENV=development

# The backend running locally (docker compose, port 4000).
#
# The LAN address is used rather than localhost because it works from every
# target: the iOS simulator, the Android emulator and a physical device on the
# same Wi-Fi. localhost only resolves to this machine from the simulator — on a
# real device it points at the phone itself.
#
# Alternatives if the LAN address changes:
#   iOS simulator only .... http://localhost:4000
#   Android emulator ...... http://10.0.2.2:4000
# Re-check this value when you switch networks: `ipconfig getifaddr en0`.
EXPO_PUBLIC_URL_DEVELOPMENT=http://192.168.1.10:4000

# Remote environments, filled in when they exist.
EXPO_PUBLIC_URL_QA=https://qa.example.com
EXPO_PUBLIC_URL_DEMO=
EXPO_PUBLIC_URL_PRODUCTION=
