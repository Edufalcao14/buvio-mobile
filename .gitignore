# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision


# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# iOS
./ios
ios
ios/Pods/
ios/build/
ios/*.xcworkspace
ios/*.xcodeproj/*

# Android
./android
android
android/.gradle/
android/app/build/
android/build/
android/local.properties

#Build 

./build

.idea

#env 
.env

.idea/

# EAS build credentials, never the build config itself (eas.json is tracked).
.easignore
credentials.json

# The documentation IS part of the project. The previous rule here excluded
# every Markdown file but the README, which meant docs/ARCHITECTURE.md and
# DESIGN.md - cited as normative by 21 source comments, and linked from the
# README's first line - reached nobody who cloned the repository.

# Audit and report artefacts are generated, never committed.
audit-report/
*.pdf
*.docx