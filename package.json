{
  "name": "buvio-frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate": "graphql-codegen --config codegen.ts",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test": "jest"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.18",
    "date-fns": "^4.4.0",
    "expo": "^57.0.9",
    "expo-constants": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "graphql-ws": "^6.2.0",
    "husky": "^9.1.7",
    "react": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1314.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-tab-view": "^4.3.2",
    "react-native-toast-message": "^2.4.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.4.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "^16.14.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "reactotron-react-native": "^5.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "zod-validation-error": "^4.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}
